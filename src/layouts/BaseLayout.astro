---
import "../styles/global.css";
const __title = Astro.props?.title ?? "CedarWolf Build + Design";
const __description =
  Astro.props?.description ??
  "Design-build and renovations in Kelowna and the Okanagan.";

const __image = Astro.props?.image ?? "/images/project-deck-1.png";

const __base = import.meta.env.BASE_URL || "/";
const __withBase = (p) => {
  if (!p) return __base;
  if (p.startsWith("http")) return p;
  const b = __base.endsWith("/") ? __base.slice(0, -1) : __base;
  const c = p.startsWith("/") ? p : ("/" + p);
  return b + c;
};

const __canonicalPath = Astro.url?.pathname || "/";
const __canonicalUrl = new URL(__withBase(__canonicalPath.replace(__base, "")), Astro.site).href;

const __ogImageUrl = __image.startsWith("http")
  ? __image
  : new URL(__withBase(__image.replace(/^\//, "")), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>

<!-- Google Ads tag -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-17823183942"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-17823183942');
</script>

<!-- Google Ads tag -->


    <!-- SEO_TAGS_START -->
    <link rel="canonical" href={__canonicalUrl} />
    <meta name="description" content={__description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CedarWolf Build + Design" />
    <meta property="og:title" content={__title} />
    <meta property="og:description" content={__description} />
    <meta property="og:url" content={__canonicalUrl} />
    <meta property="og:image" content={__ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={__title} />
    <meta name="twitter:description" content={__description} />
    <meta name="twitter:image" content={__ogImageUrl} />
    <!-- SEO_TAGS_END -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{__title}</title>
    <meta name="description" content={__description} />


</head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased min-h-screen bg-white text-slate-900">
    <slot />
  <script>
</script>
<!-- CEDARWOLF_PHONE_CONVERSION -->
<script is:inline>
  (function () {
    document.addEventListener("click", function (e) {
      const a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
      if (!a) return;

      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          // TODO: replace with your Google Ads PHONE conversion label once created
          send_to: "AW-17823183942/REPLACE_WITH_PHONE_LABEL"
        });
      }
    }, { capture: true });
  })();
</script>

</body>
</html>
