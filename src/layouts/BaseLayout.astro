---
import "../styles/global.css";
import { asset } from "../lib/asset";

const {
  title = "CedarWolf Build + Design",
  description = "Residential renovations and small builds in Kelowna and the Okanagan.",
  canonicalPath = "/",
} = Astro.props;

const site = "https://cedarwolfbuild.ca";
const canonical = new URL(canonicalPath, site).toString();
const __cw_site = Astro.site ?? new URL("https://cedarwolfbuild.ca");
const __cw_path = Astro.url?.pathname ?? "/";
const __cw_canonical = new URL(__cw_path, __cw_site).toString();
const __cw_og_image = new URL(asset("images/CEDARWOLF_BUILD_DESIGN_LOGO.png"), __cw_site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    

    <!-- Canonical + Social preview -->
    <meta property="og:site_name" content="CedarWolf Build + Design" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={__cw_canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={__cw_og_image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={__cw_og_image} />
<base href={import.meta.env.BASE_URL} />
</head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased min-h-screen bg-white text-slate-900">
    <slot />
  <script>
  document.addEventListener("contextmenu", e => e.preventDefault());
</script>
</body>
</html>
