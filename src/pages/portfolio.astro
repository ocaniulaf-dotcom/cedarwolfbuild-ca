---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { asset } from "../lib/asset";

const projects = [
  {
    tag: "Kitchens",
    title: "Kitchen Renovation",
    description:
      "Updated layout and finishes with a clean, durable look. Tight details and a jobsite you can live with.",
    image: asset("images/project-kitchen-1.png"),
    bullets: ["Scope clarity", "Millwork alignment", "Finish details"],
  },
  {
    tag: "Outdoor",
    title: "Deck Build",
    description:
      "Outdoor build focused on structure, clean lines, and long-term durability. Built to handle real weather.",
    image: asset("images/project-deck-1.png"),
    bullets: ["Solid framing", "Clean edges", "Durable materials"],
  },
  {
    tag: "Interiors",
    title: "Flooring Install",
    description:
      "Prep first, then install. Clean transitions, consistent reveals, and a finished look that feels upgraded.",
    image: asset("images/project-flooring-1.png"),
    bullets: ["Subfloor prep", "Transitions", "Trim finish"],
  },
  {
    tag: "Living spaces",
    title: "Interior Upgrades",
    description:
      "Targeted interior upgrades that improve daily living. Clean work, sharp lines, and good flow.",
    image: asset("images/cinema-room.png"),
    bullets: ["Function first", "Clean finishes", "Respectful jobsite"],
  },
];

const CONTACT = asset("contact/");
const base = import.meta.env.BASE_URL;

---
<BaseLayout title="Portfolio | CedarWolf Build + Design" description="Recent renovation and build work in Kelowna and the Okanagan.">
  <Nav />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-6 py-14">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Portfolio</h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        A selection of recent work. If you want something similar, send your scope and photos. We will reply with clear next steps.
      </p>

      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        {projects.map((p) => (
          <article class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70 shadow-sm">
            <div class="relative">
              <img src={p.image} alt={p.title} class="h-72 w-full object-cover" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/25 to-transparent"></div>
              <div class="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-900 ring-1 ring-white/30">
                {p.tag}
              </div>
            </div>

            <div class="p-6">
              <h2 class="text-xl font-semibold tracking-tight text-slate-900">{p.title}</h2>
              <p class="mt-3 text-slate-600">{p.description}</p>

              <ul class="mt-5 flex flex-wrap gap-2">
                {p.bullets.map((b) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200/60">
                    {b}
                  </li>
                ))}
              </ul>

              <div class="mt-6">
                <a href={CONTACT} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-700/30">
                  Get a quote
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-lg font-semibold text-slate-900">Want something like this?</p>
            <p class="mt-1 text-sm text-slate-600">Send your scope, rough dimensions, and a few photos. We will respond with next steps.</p>
          </div>
          <a href={CONTACT} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-700/30">
            Contact
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
