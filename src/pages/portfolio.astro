---
import BaseLayout from "../layouts/BaseLayout.astro";
import { asset } from "../lib/asset";

const CONTACT = asset("contact/");

const projectCategories = [
  {
    tag: "Fences & Gates",
    title: "Fence Installation & Gates",
    image: asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg"),
    desc: "Cedar privacy fences, composite fencing, corrugated metal fencing, custom gates, sliding gates, and fence repairs across Kelowna and the Okanagan.",
    href: asset("fence-installation-kelowna/"),
    bullets: ["Cedar Fences", "Composite Fencing", "Custom Gates", "Fence Repairs"],
  },
  {
    tag: "Decks",
    title: "Deck Building & Outdoor Living",
    image: asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-1.jpeg"),
    desc: "Deck builds, deck repairs, stairs, railings, pergolas, cedar decks, composite decks, and outdoor living upgrades.",
    href: asset("deck-building-kelowna/"),
    bullets: ["Deck Builds", "Deck Repairs", "Stairs & Railings", "Pergolas"],
  },
  {
    tag: "Land Clearing",
    title: "Acreage & Land Clearing",
    image: asset("images/kelowna-forestry-mulching-acreage-clearing-service.webp"),
    desc: "Forestry mulching, acreage clearing, brush removal, trail clearing, skid steer services, and site preparation for larger properties.",
    href: asset("forestry-mulching-skid-steer-services-kelowna/"),
    bullets: ["Forestry Mulching", "Brush Removal", "Acreage Clearing", "Site Preparation"],
  },
  {
    tag: "Renovations",
    title: "Interior Renovations",
    image: asset("images/project-kitchen-1.png"),
    desc: "Kitchen renovations, bathroom renovations, flooring, painting, drywall, trim, finishing work, and general renovation projects.",
    href: asset("services/"),
    bullets: ["Kitchens", "Bathrooms", "Flooring", "Painting"],
  },
];

const galleryImages = [
  asset("images/portfolio/fence/kelowna-cedar-privacy-fence-install-cedarwolf.jpeg"),
  asset("images/portfolio/fence/kelowna-custom-fence-gate-black-cedar-cedarwolf.jpeg"),
  asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-2.jpeg"),
  asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-7.jpeg"),
  asset("images/skid-steer-services-equipment-fleet-kelowna-bc.webp"),
  asset("images/project-flooring-1.png"),
];

const services = [
  "Fence Installation",
  "Fence Repairs",
  "Custom Gates",
  "Deck Building",
  "Deck Repairs",
  "Land Clearing",
  "Forestry Mulching",
  "Epoxy Floors",
  "Kitchen Renovations",
  "Bathroom Renovations",
  "Flooring",
  "Painting",
];
---

<BaseLayout
  title="Projects & Portfolio Kelowna | CedarWolf Build + Design"
  description="View CedarWolf Build + Design projects and services across Kelowna and the Okanagan. Fences, decks, land clearing, renovations, flooring, painting, and outdoor construction."
>
  <main class="bg-slate-50">
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img
          src={asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg")}
          alt="CedarWolf Build + Design projects in Kelowna and the Okanagan"
          class="h-[68vh] min-h-[560px] w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/70"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="max-w-3xl">
          <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 ring-1 ring-white/15">
            Kelowna & Okanagan • Outdoor Construction & Renovations
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            Projects Across the Okanagan
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
            Fences, decks, land clearing, renovations, flooring, painting, and property improvement work by CedarWolf Build + Design.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={CONTACT} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
              Request Free Estimate
            </a>
            <a href="#project-categories" class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View Project Types
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {["Registered BC Business", "Fully Insured", "WorkSafeBC Covered", "Free On-Site Estimates", "Residential & Commercial"].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold text-white shadow-sm">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="project-categories" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Featured Work</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
          Project categories and services.
        </h2>
        <p class="mt-3 text-slate-600">
          Browse the main types of work CedarWolf provides for homeowners, businesses, and property owners throughout Kelowna and the Okanagan.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {projectCategories.map((p) => (
          <article class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={p.image} alt={p.title} class="h-72 w-full object-cover" loading="lazy" />
            <div class="p-7">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800">{p.tag}</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">{p.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{p.desc}</p>

              <ul class="mt-5 flex flex-wrap gap-2">
                {p.bullets.map((b) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                    {b}
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex flex-wrap gap-3">
                <a href={p.href} class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                  View Service
                </a>
                <a href={CONTACT} class="inline-flex items-center justify-center rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
                  Request Similar Project
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Construction Services</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
              Outdoor construction and renovation work.
            </h2>
            <p class="mt-4 text-slate-600">
              CedarWolf works on practical property improvements, outdoor upgrades, repairs, renovations, and seasonal construction services across the Okanagan.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((service) => (
              <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-800 ring-1 ring-slate-200">
                ✓ {service}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Project Photos</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Recent work examples.</h2>
          <p class="mt-3 max-w-3xl text-slate-600">
            Photos from fence, deck, land clearing, flooring, and renovation-related work.
          </p>
        </div>
        <a href={CONTACT} class="inline-flex rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
          Request Estimate
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {galleryImages.map((src) => (
          <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={src} alt="CedarWolf Build + Design project photo in Kelowna" class="h-64 w-full object-cover transition duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-slate-950 p-8 text-white md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">How We Work</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">A straightforward process for similar projects.</h2>

        <div class="mt-8 grid gap-4 md:grid-cols-5">
          {[
            ["1", "Site Visit", "Review the property, access, scope, and project needs."],
            ["2", "Estimate", "Prepare pricing based on the discussed scope."],
            ["3", "Planning", "Confirm materials, scheduling, and access requirements."],
            ["4", "Construction", "Complete the work based on the agreed plan."],
            ["5", "Walkthrough", "Review the completed work and close out the project."]
          ].map(([num, title, desc]) => (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-5">
              <p class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-400 text-sm font-bold text-slate-950">{num}</p>
              <h3 class="mt-4 text-base font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Service Area</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Projects across Kelowna and the Okanagan.
          </h2>
          <p class="mt-4 max-w-2xl text-slate-600">
            CedarWolf Build + Design serves Kelowna, West Kelowna, Lake Country, Peachland, Vernon, and nearby Okanagan communities.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {["Kelowna", "West Kelowna", "Lake Country", "Peachland", "Vernon", "Okanagan Area"].map((city) => (
            <div class="rounded-2xl bg-white p-4 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 shadow-sm">
              {city}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="rounded-3xl bg-emerald-700 p-8 text-white shadow-sm md:p-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Planning a similar project?</h2>
            <p class="mt-3 max-w-2xl text-emerald-50">
              Send your location, photos if available, rough dimensions, timeline, and the type of work you need completed.
            </p>
          </div>
          <a href={CONTACT} class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
            Request Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
