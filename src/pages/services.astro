---
import { asset } from "../lib/asset";
import BaseLayout from "../layouts/BaseLayout.astro";

const outdoorServices = [
  {
    title: "Fence Installation & Repair",
    image: asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg"),
    desc: "Cedar, wood, composite, corrugated metal, privacy fences, repairs, and custom gates.",
    href: asset("fence-installation-kelowna/"),
    items: ["Privacy Fences", "Fence Repairs", "Custom Gates", "Composite & Metal"],
  },
  {
    title: "Deck Building & Repair",
    image: asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-1.jpeg"),
    desc: "New decks, deck repairs, cedar decks, composite decks, stairs, railings, and pergolas.",
    href: asset("deck-building-kelowna/"),
    items: ["Deck Builds", "Deck Repairs", "Stairs & Railings", "Pergolas"],
  },
  {
    title: "Land Clearing",
    image: asset("images/kelowna-forestry-mulching-acreage-clearing-service.webp"),
    desc: "Acreage clearing, forestry mulching, brush removal, skid steer services, and site preparation.",
    href: asset("forestry-mulching-skid-steer-services-kelowna/"),
    items: ["Forestry Mulching", "Brush Removal", "Acreage Clearing", "Site Preparation"],
  },
  {
    title: "Epoxy Floor Coatings",
    image: asset("images/service-flooring.png"),
    desc: "Garage floors, shop floors, concrete coatings, floor resurfacing, and durable surface upgrades.",
    href: asset("epoxy-floor-coating-kelowna/"),
    items: ["Garage Floors", "Shop Floors", "Concrete Coating", "Floor Resurfacing"],
  },
];

const renovationServices = [
  {
    title: "Kitchen Renovations",
    image: asset("images/project-kitchen-1.png"),
    desc: "Kitchen upgrades, cabinets, flooring, lighting, painting, trim, and general renovation work.",
    href: asset("portfolio/kitchen-renovations/"),
    items: ["Cabinets", "Flooring", "Lighting", "Finishing"],
  },
  {
    title: "Bathroom Renovations",
    image: asset("images/service-fullreno.png"),
    desc: "Bathroom updates, vanities, flooring, drywall, painting, fixtures, and finish details.",
    href: asset("contact/"),
    items: ["Vanities", "Flooring", "Drywall", "Fixtures"],
  },
  {
    title: "Flooring Installation",
    image: asset("images/project-flooring-1.png"),
    desc: "Flooring installation, subfloor prep, transitions, baseboards, and finishing details.",
    href: asset("contact/"),
    items: ["Flooring", "Transitions", "Baseboards", "Prep"],
  },
  {
    title: "Painting & Finishing",
    image: asset("images/service-painting.png"),
    desc: "Interior and exterior painting, drywall repair, trim, doors, and general finishing work.",
    href: asset("small-projects/"),
    items: ["Painting", "Drywall Repair", "Trim", "Doors"],
  },
];

const trust = [
  "Registered BC Business",
  "Fully Insured",
  "WorkSafeBC Covered",
  "Free On-Site Estimates",
  "Residential & Commercial",
];
---

<BaseLayout
  title="Construction & Renovation Services Kelowna | CedarWolf Build + Design"
  description="Construction and renovation services in Kelowna and the Okanagan. Fence installation, deck building, land clearing, epoxy floors, kitchens, bathrooms, flooring, painting, and general renovations."
>
  <main class="bg-slate-50">
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img
          src={asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-1.jpeg")}
          alt="Construction and renovation services in Kelowna"
          class="h-[68vh] min-h-[560px] w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/70"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="max-w-3xl">
          <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 ring-1 ring-white/15">
            Kelowna & Okanagan • Residential & Commercial
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            Construction & Renovation Services in Kelowna
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
            Outdoor construction, interior renovations, property improvements, and seasonal services across Kelowna and the Okanagan.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
              Request Free Estimate
            </a>
            <a href="#outdoor-services" class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View Services
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {trust.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold text-white shadow-sm">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="outdoor-services" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Spring & Summer</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Outdoor Construction</h2>
        <p class="mt-3 text-slate-600">
          Outdoor services for privacy, outdoor living, property access, concrete surfaces, and acreage improvement.
        </p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {outdoorServices.map((s) => (
          <article class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={s.image} alt={s.title} class="h-72 w-full object-cover" loading="lazy" />
            <div class="p-7">
              <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.desc}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {s.items.map((item) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={s.href} class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                  Learn More
                </a>
                <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
                  Request Estimate
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Year-Round</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Renovation Services</h2>
        <p class="mt-3 text-slate-600">
          Interior renovation and finishing services for homes, rental properties, small commercial spaces, and ongoing property improvements.
        </p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {renovationServices.map((s) => (
          <article class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={s.image} alt={s.title} class="h-72 w-full object-cover" loading="lazy" />
            <div class="p-7">
              <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.desc}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {s.items.map((item) => (
                  <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={s.href} class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                  Learn More
                </a>
                <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
                  Request Estimate
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Build With Confidence</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Professional standards across every service.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-5">
          {trust.map((item) => (
            <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
              <p class="text-base font-semibold text-slate-900">✓ {item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="rounded-3xl bg-emerald-700 p-8 text-white shadow-sm md:p-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Need help choosing the right service?</h2>
            <p class="mt-3 max-w-2xl text-emerald-50">
              Send your project type, location, rough dimensions, timeline, and photos if available. We will review the project and respond with next steps.
            </p>
          </div>
          <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
            Request Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
