---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="About | CedarWolf Build + Design">
  <Nav />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-6 py-14">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">About</h1>

      <div class="mt-8 grid gap-10 lg:grid-cols-2">
        <div class="rounded-2xl bg-white p-8 ring-1 ring-slate-200/70 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-900">Built for real homes</h2>
          <p class="mt-4 text-slate-600">
            CedarWolf Build + Design delivers residential renovations across Kelowna and the Okanagan with clear scope, clean execution, and durable finishes.
          </p>
          <ul class="mt-6 space-y-2 text-slate-700">
            <li>• Clear scope and sequencing</li>
            <li>• Detail-focused finish work</li>
            <li>• Respectful jobsite and communication</li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-2xl ring-1 ring-slate-200/70 shadow-sm">
          <img src="/images/Collage-1.png" alt="Project collage" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
