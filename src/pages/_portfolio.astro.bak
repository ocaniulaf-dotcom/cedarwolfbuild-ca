---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const items = [
  { title: "Kitchen renovation", image: "/images/project-kitchen-1.png" },
  { title: "Deck build", image: "/images/project-deck-1.png" },
  { title: "Flooring install", image: "/images/project-flooring-1.png" },
  { title: "Cinema room", image: "/images/cinema-room.png" },
  { title: "Game center", image: "/images/game-center.png" },
  { title: "Backyard office", image: "/images/backyard-office.png" },
];
---

<BaseLayout title="Portfolio | CedarWolf Build + Design">
  <Nav />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-7xl px-6 py-14">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Portfolio</h1>
      <p class="mt-4 max-w-2xl text-slate-600">A sample of recent work. If you want something similar, contact us with your scope.</p>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => (
          <article class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="relative">
              <img src={p.image} alt={p.title} class="h-60 w-full object-cover" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/25 to-transparent"></div>
            </div>
            <div class="p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
