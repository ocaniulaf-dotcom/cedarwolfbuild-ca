---
import { asset } from "../lib/asset";
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  "Fence Installation & Repair",
  "Deck Building & Repair",
  "Land Clearing",
  "Epoxy Floors",
  "Kitchen Renovations",
  "Bathroom Renovations",
  "Flooring",
  "Painting",
  "General Renovations",
];

const serviceAreas = [
  "Kelowna",
  "West Kelowna",
  "Lake Country",
  "Peachland",
  "Vernon",
  "Okanagan Area",
];
---

<BaseLayout
  title="About CedarWolf Build + Design | Kelowna Contractor"
  description="About CedarWolf Build + Design, a Kelowna construction and renovation contractor serving residential and commercial clients across the Okanagan."
>
  <main class="bg-slate-50">
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img
          src={asset("images/Collage-1.png")}
          alt="CedarWolf Build + Design project collage"
          class="h-[68vh] min-h-[560px] w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/70"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="max-w-3xl">
          <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 ring-1 ring-white/15">
            Kelowna & Okanagan • Construction & Renovation Services
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            About CedarWolf Build + Design
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
            CedarWolf provides construction, renovation, outdoor construction, and property improvement services for homeowners, businesses, and property owners across Kelowna and the Okanagan.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
              Request Free Estimate
            </a>
            <a href={asset("portfolio/")} class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View Projects
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {["Registered BC Business", "Fully Insured", "WorkSafeBC Covered", "Free On-Site Estimates", "Residential & Commercial"].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold text-white shadow-sm">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Who We Are</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            A Kelowna contractor focused on practical construction solutions.
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            CedarWolf Build + Design works on indoor and outdoor projects, including fences, decks, land clearing, epoxy floors, kitchens, bathrooms, flooring, painting, and general renovation work.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The goal is simple: review the project, define the scope, plan the work, and complete the project according to the agreed scope.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-6 ring-1 ring-slate-200 shadow-sm">
          <img
            src={asset("images/Collage-1.png")}
            alt="CedarWolf Build + Design renovation and construction work"
            class="h-full max-h-[520px] w-full rounded-2xl object-contain"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Build With Confidence</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
          Professional standards for residential and commercial work.
        </h2>

        <div class="mt-8 grid gap-4 md:grid-cols-5">
          {[
            ["Registered BC Business", "Operating as a local British Columbia business."],
            ["Fully Insured", "Insurance coverage for residential and commercial work."],
            ["WorkSafeBC Covered", "WorkSafeBC coverage for compliant jobsite operations."],
            ["Free On-Site Estimates", "Site visits available for suitable projects."],
            ["Residential & Commercial", "Services for homes, businesses, and properties."]
          ].map(([title, desc]) => (
            <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
              <p class="text-base font-semibold text-slate-900">✓ {title}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl bg-slate-950 p-8 text-white md:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">How We Work</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight">A straightforward project process.</h2>

          <div class="mt-8 space-y-4">
            {[
              ["1", "Site Visit", "Review the property, access, scope, and project needs."],
              ["2", "Estimate", "Prepare pricing based on the discussed scope."],
              ["3", "Planning", "Confirm materials, scheduling, and access requirements."],
              ["4", "Construction", "Complete the work based on the agreed plan."],
              ["5", "Walkthrough", "Review the completed work and close out the project."]
            ].map(([num, title, desc]) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 p-5">
                <p class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-400 text-sm font-bold text-slate-950">{num}</p>
                <h3 class="mt-4 text-base font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">{desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">What We Do</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Indoor and outdoor construction services.
          </h2>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {services.map((service) => (
              <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-800 ring-1 ring-slate-200">
                ✓ {service}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Service Area</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Serving Kelowna and the Okanagan.
          </h2>
          <p class="mt-4 max-w-2xl text-slate-600">
            CedarWolf Build + Design serves homeowners, businesses, and property owners across Kelowna, West Kelowna, Lake Country, Peachland, Vernon, and nearby Okanagan communities.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {serviceAreas.map((city) => (
            <div class="rounded-2xl bg-white p-4 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 shadow-sm">
              {city}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="rounded-3xl bg-emerald-700 p-8 text-white shadow-sm md:p-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Planning a project?</h2>
            <p class="mt-3 max-w-2xl text-emerald-50">
              Send your project type, location, photos if available, rough dimensions, and timeline.
            </p>
          </div>
          <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
            Request Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
