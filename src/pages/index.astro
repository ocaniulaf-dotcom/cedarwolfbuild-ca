---
import { asset } from "../lib/asset";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const projects = [
  { title: "Kitchen renovation", image: asset("images/project-kitchen-1.png"), tag: "Kitchens" },
  { title: "Deck build", image: asset("images/project-deck-1.png"), tag: "Outdoor" },
  { title: "Flooring install", image: asset("images/project-flooring-1.png"), tag: "Interiors" },
];
---

<BaseLayout title="CedarWolf Build + Design | Kelowna Renovations">
  <Nav />

  <main class="bg-slate-50">
    <!-- HERO -->
    <section class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <img src={import.meta.env.BASE_URL + "images/lake-sunset.png"} alt="Kelowna lake sunset" class="h-[70vh] w-full object-cover" />
        <div class="absolute inset-0 bg-slate-950/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-slate-950/25 to-transparent"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 pt-24 pb-16">
        <div class="max-w-2xl">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white ring-1 ring-white/15">
            Kelowna + Okanagan • Residential Renovations
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            High-end renovations, built to last.
          </h1>

          <p class="mt-5 text-base leading-relaxed text-white/80 sm:text-lg">
            Kitchens, built-ins, flooring, and finish work. Clear scope, clean execution, and a jobsite you can live with.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={asset("contact/")}
              class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-700/30">
              Get a quote
            </a>
            <a href={asset("portfolio/")}
              class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View projects
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="mx-auto max-w-7xl px-6 py-10">
      <div class="grid gap-4 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold text-slate-900">Clear scope</p>
          <p class="mt-1 text-sm text-slate-600">No vague promises. You know what’s included.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Clean finishes</p>
          <p class="mt-1 text-sm text-slate-600">Tight details. Durable materials. Proper prep.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Respectful jobsite</p>
          <p class="mt-1 text-sm text-slate-600">Dust control, protection, and communication.</p>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECTS -->
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Featured projects</h2>
          <p class="mt-2 text-slate-600">A few recent examples. More in the portfolio.</p>
        </div>
        <a href={asset("portfolio/")} class="hidden rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 sm:inline-flex">
          Portfolio
        </a>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {projects.map((p) => (
          <article class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="relative">
              <img src={p.image} alt={p.title} class="h-56 w-full object-cover" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/20 to-transparent"></div>
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800">{p.tag}</p>
              <h3 class="mt-2 text-base font-semibold text-slate-900">{p.title}</h3>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-lg font-semibold text-slate-900">Want a quote with a clear scope?</p>
            <p class="mt-1 text-sm text-slate-600">Tell us what you’re planning. We’ll respond with next steps.</p>
          </div>
          <a href={asset("contact/")}
            class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-700/30">
            Contact
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
