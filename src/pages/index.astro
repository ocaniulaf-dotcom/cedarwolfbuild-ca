---
import { asset } from "../lib/asset";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Kitchen Renovation",
    image: asset("images/project-kitchen-1.png"),
    tag: "Kitchens",
    desc: "Full kitchen transformations — cabinets, countertops, lighting, and layout.",
    href: asset("portfolio/kitchen-renovations/"),
  },
  {
    title: "Deck Building",
    image: asset("images/portfolio/deck/kelowna-deck-build-cedarwolf-1.jpeg"),
    tag: "Outdoor",
    desc: "Custom cedar and composite decks built to BC code with clean finishes.",
    href: asset("deck-building-kelowna/"),
  },
  {
    title: "Fence Installation",
    image: asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg"),
    tag: "Fencing",
    desc: "Wood, cedar, and modern metal fences built straight and set to last.",
    href: asset("fence-installation-kelowna/"),
  },
];
---

<BaseLayout
  title="General Contractor in Kelowna | CedarWolf Build + Design"
  description="Licensed general contractor in Kelowna specializing in residential renovations, kitchens, decks, fencing, flooring, and finish carpentry. Clear scope. Clean execution."
>
  <main class="bg-slate-50">
    <!-- HERO -->
    <section class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <img src={import.meta.env.BASE_URL + "images/lake-sunset.png"} alt="Kelowna lake sunset" class="h-[70vh] w-full object-cover" />
        <div class="absolute inset-0 bg-slate-950/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-slate-950/25 to-transparent"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 pt-24 pb-16">
        <div class="max-w-2xl">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white ring-1 ring-white/15">
            Kelowna & West Kelowna • Residential Renovation Contractor
          </p>
          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            General Contractor in Kelowna
          </h1>
          <p class="mt-4 text-lg text-white/90 sm:text-xl">
            High-end residential renovations with clear scope, proper sequencing, and durable finishes.
          </p>
          <p class="mt-5 text-base leading-relaxed text-white/80 sm:text-lg">
            Kitchens, decks, fencing, flooring, and finish work. Clear scope, clean execution, and a jobsite you can live with.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={asset("contact/")}
              class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
              Get a quote
            </a>
            <a href={asset("portfolio/")}
              class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View projects
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="h-14 bg-slate-50"></div>

    <!-- LOCAL SEO -->
    <section class="mx-auto max-w-7xl px-6 py-12">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold text-slate-900">
          Trusted General Contractor in Kelowna
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          CedarWolf Build + Design is a licensed and insured general contractor serving Kelowna and West Kelowna.
          We specialize in residential renovations including kitchens, decks, fencing, flooring, cabinetry, framing,
          and finish carpentry. Our work is defined by clear scope, realistic schedules, and clean, well-managed jobsites.
        </p>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="mx-auto max-w-7xl px-6 py-10">
      <div class="grid gap-4 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold text-slate-900">Clear scope</p>
          <p class="mt-1 text-sm text-slate-600">No vague promises. You know what is included.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Clean finishes</p>
          <p class="mt-1 text-sm text-slate-600">Tight details. Durable materials. Proper prep.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Respectful jobsite</p>
          <p class="mt-1 text-sm text-slate-600">Dust control, protection, and communication.</p>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECTS -->
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Featured projects</h2>
          <p class="mt-2 text-slate-600">Recent work in Kelowna and West Kelowna.</p>
        </div>
        <a href={asset("portfolio/")} class="hidden rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 sm:inline-flex">
          Portfolio
        </a>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {projects.map((p) => (
          <a href={p.href} class="group overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="relative">
              <img src={p.image} alt={p.title} class="h-56 w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/20 to-transparent"></div>
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800">{p.tag}</p>
              <h3 class="mt-2 text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{p.desc}</p>
              <p class="mt-3 text-sm font-semibold text-emerald-700 group-hover:underline">See this service →</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-lg font-semibold text-slate-900">Want a quote with a clear scope?</p>
            <p class="mt-1 text-sm text-slate-600">Tell us what you are planning. We will respond with next steps within one business day.</p>
          </div>
          <a href={asset("contact/")}
            class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
            Get a free quote
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
