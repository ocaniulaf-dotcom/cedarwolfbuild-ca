---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const phone = "+1 778 594 1722";
const email = "projects@cedarwolfbuild.ca";
---
<BaseLayout
  title="CedarWolf Build + Design. Kelowna Renovations and Custom Builds"
  description="High-quality residential renovations and custom projects in Kelowna and the Okanagan. Clear scope. clean execution. professional finish."
  canonicalPath="/"
>
  <Nav />

  <!-- HERO -->
  <section class="relative h-[52vh] min-h-[360px] max-h-[520px] w-full">
    <img
      src="/images/lake-sunset.png"
      alt="Kelowna lake sunset with residential homes"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/45"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-6xl items-center px-4">
      <div class="max-w-2xl text-white">
        <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
          Build it right.<br />Design it clean.
        </h1>
        <p class="mt-4 text-lg text-white/90">
          Residential renovations and custom projects across Kelowna and the Okanagan.
          Clear scope. realistic schedule. clean finish.
        </p>
        <div class="mt-6 flex gap-3">
          <a
            href="/contact"
            class="rounded-xl bg-white px-5 py-3 text-sm font-medium text-slate-900 hover:bg-slate-100"
          >
            Request a quote
          </a>
          <a
            href="/work"
            class="rounded-xl border border-white/60 px-5 py-3 text-sm font-medium text-white hover:bg-white/10"
          >
            View portfolio
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <main class="mx-auto max-w-6xl px-4 py-14">
    <section class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight">
          Renovations done with control and care
        </h2>
        <p class="mt-4 text-slate-700">
          CedarWolf Build + Design delivers high-quality residential renovations with a
          project-driven approach. No vague scopes. no fantasy timelines. just solid work.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-slate-700">
          <li>• Kitchens, flooring, painting, framing</li>
          <li>• Full renovations and custom feature builds</li>
          <li>• Backyard offices, media walls, cinema rooms</li>
          <li>• Design and project management support</li>
        </ul>

        <div class="mt-6 text-sm text-slate-700">
          <div><span class="text-slate-500">Phone:</span> {phone}</div>
          <div>
            <span class="text-slate-500">Email:</span>
            <a class="underline" href={`mailto:${email}`}>{email}</a>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border bg-slate-50 p-8">
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <div class="text-xs text-slate-500">Approach</div>
            <div class="mt-1 font-semibold">Scope first</div>
          </div>
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <div class="text-xs text-slate-500">Planning</div>
            <div class="mt-1 font-semibold">Real schedules</div>
          </div>
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <div class="text-xs text-slate-500">Execution</div>
            <div class="mt-1 font-semibold">Clean workmanship</div>
          </div>
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <div class="text-xs text-slate-500">Delivery</div>
            <div class="mt-1 font-semibold">Professional finish</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
