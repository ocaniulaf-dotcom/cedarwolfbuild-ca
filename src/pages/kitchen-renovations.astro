---
import BaseLayout from "../layouts/BaseLayout.astro";

const PHONE_DISPLAY = "778-594-1722";
const PHONE_TEL = "+17785941722";
const EMAIL = "projects@cedarwolfbuild.ca";
---

<BaseLayout
  title="Kitchen Renovations in Kelowna | CedarWolf Build + Design"
  description="Kitchen renovations in Kelowna and the Okanagan. Licensed and insured general contractor. Clear scope, realistic timelines, and high-quality finishes. Free estimates by email."
>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <section class="grid gap-8 md:grid-cols-2 md:items-center">
      <div class="space-y-5">
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700">
          Licensed & insured . Kelowna + Okanagan
        </p>

        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 md:text-5xl">
          Kitchen Renovations in Kelowna and the Okanagan
        </h1>

        <p class="text-base leading-relaxed text-slate-700 md:text-lg">
          Well-managed kitchen renovations with clear scope, realistic timelines, and durable finishes.
          Email works best while we’re on site. We respond within 1 business day.
        </p>

        <ul class="grid gap-2 text-sm text-slate-700">
          <li>Design-build renovation delivery</li>
          <li>Cabinetry, flooring, lighting, drywall, paint</li>
          <li>Email-first quotes . Clear written scope</li>
        </ul>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={"mailto:" + EMAIL + "?subject=Kitchen Renovation Request"}
            class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800"
          >
            Request a quote by email
          </a>

          <a
            href={"tel:" + PHONE_TEL}
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-50"
          >
            Call if urgent
          </a>
        </div>

        <p class="text-xs text-slate-500">
          Email: <a class="underline hover:no-underline" href={"mailto:" + EMAIL}>{EMAIL}</a> . Phone is answered when available.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-100">
          <img
            src="/images/portfolio/kitchen-renovations/hero.jpg"
            alt="Kitchen renovation project in Kelowna"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
