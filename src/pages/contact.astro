---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Contact | CedarWolf Build + Design">
  <Nav />

  <main class="bg-stone-100">
    <section class="relative overflow-hidden bg-stone-100">
  <div class="absolute inset-0 bg-[url(/images/service-framing.png)] bg-cover bg-center opacity-[0.06]"></div>
  <div class="relative mx-auto max-w-7xl px-6 py-14">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Contact</h1>
{Astro.url.searchParams.get("sent") === "1" && (
  <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-900">
    Thanks. Your request was sent. If you don’t hear back within 1 business day, call or email us.
  </div>
)}
      <p class="mt-4 max-w-2xl text-slate-600">
        Send your project details. You’ll get a clear next step, not a vague “we’ll see”.
      </p>

      <div class="mt-10 grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2 rounded-2xl bg-white p-8 ring-1 ring-slate-200/70 shadow-sm">
          
        </div>

        <div class="rounded-2xl bg-white p-8 ring-1 ring-slate-200/70 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-900">Direct contact</h2>
          <div class="mt-4 space-y-2 text-sm text-slate-700">
            <p><span class="font-semibold text-slate-900">Phone:</span> +1 778 594 1722</p>
            <p><span class="font-semibold text-slate-900">Email:</span> projects@cedarwolfbuild.ca</p>
            <p class="pt-2"><span class="font-semibold text-slate-900">Service area:</span> Kelowna, West Kelowna, Lake Country, Peachland, Vernon</p>
          </div>
        </div>
      </div>
    </div>
</section>
  
      <div class="mt-10 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900">Request a quote</h2>
        <p class="mt-2 text-sm text-slate-600">This form opens your email app and sends your details to projects@cedarwolfbuild.ca.</p>

        <form action="https://formspree.io/f/mzdpbapp" method="POST" class="space-y-5">
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800">Name</label>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
        placeholder="Your name"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-800">Phone or email</label>
      <input
        type="text"
        name="contact"
        required
        autocomplete="email"
        class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
        placeholder="+1 778... or name@email.com"
      />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800">Project location</label>
    <input
      type="text"
      name="location"
      class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
      placeholder="Kelowna, West Kelowna, Lake Country..."
    />
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800">Scope</label>
    <textarea
      name="message"
      rows="7"
      required
      class="mt-2 w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
      placeholder="Tell us what you want done, rough dimensions, timeline, and any constraints. Attach photos by replying to the email you receive."
    ></textarea>
  </div>

  <input type="hidden" name="_subject" value="New quote request - CedarWolf Build + Design" />
  <input type="hidden" name="_redirect" value="/cedarwolfbuild-ca/contact?sent=1" />

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-xl bg-emerald-700 px-6 py-3 font-semibold text-white shadow-sm hover:bg-emerald-800"
    >
      Send
    </button>

    <p class="text-sm text-slate-600">
      Or call <a class="font-semibold text-slate-800 hover:underline" href="tel:+17785941722">+1 778 594 1722</a>
      . Email <a class="font-semibold text-slate-800 hover:underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a>
    </p>
  </div>
</form>

        </div>

</main>

  <Footer />
</BaseLayout>
