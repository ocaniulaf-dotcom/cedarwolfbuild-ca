---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | CedarWolf Build + Design">
  <main class="bg-stone-100">
    <section class="relative overflow-hidden bg-stone-100">
      <div class="absolute inset-0 bg-[url(/images/service-framing.png)] bg-cover bg-center opacity-[0.06]"></div>

      <div class="relative mx-auto max-w-7xl px-6 py-14">
        <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Contact</h1>

        {Astro.url.searchParams.get("sent") === "1" && (
          <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-900">
            Thanks. Your request was sent. If you don’t hear back within 1 business day, call or email us.
          </div>
        )}

        <p class="mt-4 max-w-2xl text-slate-600">
          Send your project details. You’ll get a clear next step, not a vague “we’ll see”.
        </p>

        <div class="mt-10 grid gap-8 lg:grid-cols-3 lg:items-start">
          <div class="lg:col-span-2 rounded-2xl bg-white p-8 ring-1 ring-slate-200/70 shadow-sm">
            <div class="grid gap-6 lg:grid-cols-5">
              <div class="lg:col-span-3">
                <div class="overflow-hidden rounded-2xl ring-1 ring-slate-200 shadow-sm">
                  <img
                    src={`${import.meta.env.BASE_URL}images/project-deck-1.png`}
                    alt="CedarWolf Build + Design. Recent work in Kelowna and the Okanagan."
                    class="h-72 w-full object-cover sm:h-80 lg:h-[420px]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="mt-5 rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                  <p class="text-sm font-semibold text-slate-900">Best results</p>
                  <p class="mt-1 text-sm text-slate-700">
                    Include rough dimensions, photos, and your target timeline. You can reply to our email to attach more photos.
                  </p>
                </div>
              </div>

              <div class="lg:col-span-2">
                <h2 class="text-xl font-semibold text-slate-900">What to expect</h2>

                <ol class="mt-4 space-y-3 text-sm text-slate-700">
                  <li class="flex gap-3">
                    <span class="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">1</span>
                    <span>Reply within 1 business day.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">2</span>
                    <span>Quick call to confirm scope, budget range, and timeline.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">3</span>
                    <span>If it’s a fit, we book a short site visit and send next steps.</span>
                  </li>
                </ol>

                <div class="mt-6 rounded-xl bg-white p-4 ring-1 ring-slate-200 shadow-sm">
                  <p class="text-sm font-semibold text-slate-900">Service area</p>
                  <p class="mt-1 text-sm text-slate-700">Kelowna. West Kelowna. Lake Country. Peachland. Vernon.</p>

                  <div class="mt-4 space-y-2 text-sm text-slate-700">
                    <p>
                      <span class="font-semibold text-slate-900">Phone:</span>
                      <a class="hover:underline" href="tel:+17785941722">+1 778 594 1722</a>
                    </p>
                    <p>
                      <span class="font-semibold text-slate-900">Email:</span>
                      <a class="hover:underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl bg-white/90 p-6 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-xl font-semibold text-slate-900">Tell Us About Your Project</h2>
            <p class="mt-2 text-sm text-slate-600">
              Send your project type, location, timeline, and a short description. We’ll review it and respond with next steps.
            </p>

            <div class="mt-6">
              <form
                id="contact-form"
                action="https://formspree.io/f/mzdpbapp"
                method="POST"
                class="space-y-5"
                data-base={import.meta.env.BASE_URL}
              >
                <div class="grid gap-4 md:grid-cols-2">
                  <div>
                    <label class="block text-sm font-medium text-slate-800">Name</label>
                    <input
                      type="text"
                      name="name"
                      required
                      autocomplete="name"
                      class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                      placeholder="Your name"
                    />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-slate-800">Email</label>
                    <input
                      type="email"
                      name="email"
                      required
                      autocomplete="email"
                      class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                      placeholder="name@email.com"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-800">Phone</label>
                  <input
                    type="tel"
                    name="phone"
                    required
                    autocomplete="tel"
                    class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                    placeholder="+1 778 594 1722"
                  />
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-800">Project type</label>
                  <select
                    name="project_type"
                    required
                    class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                  >
                    <option value="">Select a service</option>
                    <option>Fence Installation / Repair</option>
                    <option>Deck Building / Repair</option>
                    <option>Land Clearing / Forestry Mulching</option>
                    <option>Epoxy Floor Coating</option>
                    <option>Kitchen Renovation</option>
                    <option>Bathroom Renovation</option>
                    <option>Flooring</option>
                    <option>Painting</option>
                    <option>Small Projects</option>
                    <option>General Renovation</option>
                    <option>Other</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-800">Project location</label>
                  <input
                    type="text"
                    name="location"
                    class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                    placeholder="Example: Lower Mission, Kelowna"
                  />
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-800">Preferred timeline</label>
                  <select
                    name="timeline"
                    class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                  >
                    <option value="">Select timeline</option>
                    <option>As soon as possible</option>
                    <option>Within 1 month</option>
                    <option>1 to 3 months</option>
                    <option>Just planning</option>
                    <option>Flexible</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-slate-800">Project details</label>
                  <textarea
                    name="message"
                    rows="7"
                    minlength="20"
                    required
                    class="mt-2 w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-300"
                    placeholder="Example: Replace approximately 90 ft of cedar fence with one gate. Existing fence needs removal. Looking to complete the project this summer."
                  ></textarea>
                  <p class="mt-2 text-xs leading-relaxed text-slate-500">
                    Have photos? After submitting the form, reply to our email with project photos so we can review the site conditions before the estimate.
                  </p>
                </div>

                <input type="hidden" name="_gotcha" value="" style="display:none" tabindex="-1" autocomplete="off" />

                <input type="hidden" name="_subject" value="New quote request - CedarWolf Build + Design" />

                <input type="hidden" name="_next" value="https://www.cedarwolfbuild.ca/thank-you/" />

                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <button
                    type="submit"
                    class="inline-flex items-center justify-center rounded-xl bg-emerald-700 px-6 py-3 font-semibold text-white shadow-sm hover:bg-emerald-800"
                  >
                    Send
                  </button>

                  <p class="text-sm text-slate-600">
                    Or call <a class="font-semibold text-slate-800 hover:underline" href="tel:+17785941722">+1 778 594 1722</a>
                    . Email <a class="font-semibold text-slate-800 hover:underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a>
                  </p>
                </div>
  <p id="contact-success" class="hidden mt-3 text-sm text-emerald-800">Message sent successfully.</p>
  <p id="contact-error" class="hidden mt-3 text-sm text-red-700">Something failed. Please try again or call us.</p>
</form>

<script>
(function(){
  const form=document.getElementById("contact-form");
  if(!form)return;
  const success=document.getElementById("contact-success");
  const error=document.getElementById("contact-error");
  const btn=form.querySelector("button[type=submit]");

  form.addEventListener("submit",async function(e){
    e.preventDefault();
    success.classList.add("hidden");
    error.classList.add("hidden");
    if(btn) btn.disabled=true;

    try{
      const res=await fetch(form.action,{
        method:"POST",
        body:new FormData(form),
        headers:{Accept:"application/json"}
      });

      if(res.ok){
        success.classList.remove("hidden");
        form.reset();
        setTimeout(() => {
          window.location.href = "/thank-you/";
        }, 1200);
      } else {
        error.classList.remove("hidden");
      }

    } catch(_) {
      error.classList.remove("hidden");
    } finally {
      if(btn) btn.disabled=false;
    }
  });
})();
</script>

            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

