---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    title: "Kitchen Renovations",
    desc: "Layout upgrades, cabinets, lighting, and finish work. Built for daily use, not Instagram only.",
    img: "/images/service-kitchen.png",
    bullets: ["Design support", "Cabinetry and installs", "Finish carpentry and trim"],
  },
  {
    title: "Cabinets and Built-ins",
    desc: "Install, upgrades, and custom built-ins. Clean lines, tight reveals, durable hardware.",
    img: "/images/service-cabinets.png",
    bullets: ["Kitchen islands", "Pantries and storage", "Trim and hardware"],
  },
  {
    title: "Painting and Finishing",
    desc: "Prep that lasts. Crisp edges. Smooth walls. A finish that looks high-end, not rushed.",
    img: "/images/service-painting.png",
    bullets: ["Interior paint", "Drywall patching", "Trim finishing"],
  },
  {
    title: "Flooring",
    desc: "Removal, prep, install, transitions, baseboards. Done clean and level.",
    img: "/images/service-flooring.png",
    bullets: ["Vinyl plank", "Laminate", "Baseboards and transitions"],
  },
  {
    title: "Framing and Repairs",
    desc: "Structural refreshes and framing adjustments where applicable. Done safely and by the book.",
    img: "/images/service-framing.png",
    bullets: ["Walls and openings", "Repairs", "Layout changes"],
  },
  {
    title: "Full Renovations",
    desc: "Scope, schedule, and coordination. One plan. One team. Less chaos.",
    img: "/images/service-fullreno.png",
    bullets: ["Phased planning", "Trade coordination", "Quality control walkthroughs"],
  },
  {
    title: "Design and Project Management",
    desc: "Clear scope, realistic schedule, cost visibility. You’ll know what’s happening and why.",
    img: "/images/service-designpm.png",
    bullets: ["Scope definition", "Budget and schedule", "Progress updates"],
  },

  // New services
  {
    title: "Backyard Office",
    desc: "A quiet, clean backyard workspace. Designed for comfort, power, and year-round use.",
    img: "/images/backyard-office.png",
    bullets: ["Insulation and finishing", "Electrical and lighting", "Clean exterior details"],
  },
  {
    title: "Media Wall. Chimney + TV",
    desc: "A cohesive focal wall integrating TV and electric fireplace with hidden wiring and balanced proportions.",
    img: "/images/chimney-tv.png",
    bullets: ["Hidden wiring", "Safe clearances", "Stone, shiplap, or custom finish"],
  },
  {
    title: "Cinema Room",
    desc: "Dark, immersive, acoustically improved theater spaces with layered dimmable lighting and clean installs.",
    img: "/images/cinema-room.png",
    bullets: ["Acoustic treatment", "Low-glare finishes", "LED accents and dimmers"],
  },
  {
    title: "Game Center",
    desc: "High-end gaming setup builds with lighting, cable management, and a premium, cohesive look.",
    img: "/images/game-center.png",
    bullets: ["LED layout", "Cable hiding and power", "Desk wall and feature finishes"],
  },
];
---
<BaseLayout title="Services. CedarWolf Build + Design" canonicalPath="/services">
  <Nav />
  <main class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tight">Services</h1>
      <p class="mt-3 text-slate-700">
        High-quality residential renovations in Kelowna and the Okanagan. Clear scope. clean execution. professional finish.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {services.map(s => (
        <ServiceCard title={s.title} desc={s.desc} img={s.img} bullets={s.bullets} />
      ))}
    </div>

    <div class="mt-12 rounded-2xl border bg-slate-50 p-8">
      <h2 class="text-xl font-semibold">Request a quote</h2>
      <p class="mt-2 text-sm text-slate-700">
        Send photos, a short scope, and your timeline. We’ll reply with next steps and a realistic schedule window.
      </p>
      <a class="mt-5 inline-block rounded-xl bg-slate-900 px-5 py-3 text-sm font-medium text-white hover:opacity-90" href="/contact">
        Contact CedarWolf
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<!-- IDEAL SERVICE CARD (TEMPLATE) -->
<section class="mt-16 max-w-7xl mx-auto px-6">
  <article class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
    <div class="relative">
      <img
        src="/images/service-kitchen.png"
        alt="Kitchen renovation"
        class="h-56 w-full object-cover"
        loading="lazy"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/20 to-transparent"></div>
    </div>

    <div class="h-1 w-full bg-emerald-800"></div>

    <div class="p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800">
        Residential Renovations
      </p>

      <h3 class="mt-2 text-xl font-semibold tracking-tight text-slate-900">
        Kitchen Renovations
      </h3>

      <p class="mt-3 text-slate-600">
        Layout upgrades, cabinetry, lighting, and finish work. Built for daily use, not Instagram only.
      </p>

      <ul class="mt-5 space-y-2 text-slate-700">
        <li class="flex items-start gap-2">
          <span class="mt-2 h-1.5 w-1.5 rounded-full bg-emerald-800"></span>
          <span>Design support and clear scope</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-2 h-1.5 w-1.5 rounded-full bg-emerald-800"></span>
          <span>Cabinetry installs and upgrades</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-2 h-1.5 w-1.5 rounded-full bg-emerald-800"></span>
          <span>Finish carpentry and trim</span>
        </li>
      </ul>

      <div class="mt-6">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-xl bg-emerald-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-800/30"
        >
          Request a quote
        </a>
      </div>
    </div>
  </article>
</section>

