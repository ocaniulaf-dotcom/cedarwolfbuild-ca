---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | CedarWolf Build + Design"
  description="Thanks for contacting CedarWolf Build + Design. We will respond shortly."
>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Thank you.</h1>
    <p class="mt-4 text-lg">
      We received your message and will get back to you as soon as possible.
    </p>

    <div class="mt-8 rounded-2xl border border-neutral-200 p-6">
      <p class="font-medium">Need to reach us faster?</p>
      <ul class="mt-3 space-y-2">
        <li>
          <span class="font-medium">Phone:</span>
          <a class="underline" href="tel:+17785941722">778-594-1722</a>
        </li>
        <li>
          <span class="font-medium">Email:</span>
          <a class="underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a>
        </li>
      </ul>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a class="rounded-xl border border-neutral-300 px-5 py-3 hover:bg-neutral-50" href="/">
        Back to Home
      </a>
      <a class="rounded-xl border border-neutral-300 px-5 py-3 hover:bg-neutral-50" href="/services/">
        View Services
      </a>
      <a class="rounded-xl border border-neutral-300 px-5 py-3 hover:bg-neutral-50" href="/small-projects/">
        Small Projects
      </a>
    </div>
  </main>
  <script>
    window.addEventListener("load", function () {
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          send_to: "AW-17823183942/m-SzCMTzhascEMbo4LJC",
          value: 1.0,
          currency: "CAD"
        });
      }
    });
  </script>
</BaseLayout>
