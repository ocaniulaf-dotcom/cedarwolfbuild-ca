---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank you | CedarWolf Build + Design">
  <main class="max-w-5xl mx-auto px-4 py-16 text-center">
    
    <img
      src="/images/thank-you-desk.jpg"
      alt="Custom home planning and renovation design workspace"
      class="w-full rounded-lg mb-10"
      loading="eager"
    />

    <h1 class="text-3xl font-semibold mb-4">Thank you.</h1>

    <p class="text-lg mb-6">
      Your request has been received.
    </p>

    <p class="text-base text-slate-600 max-w-3xl mx-auto mb-6">
      We’re reviewing your project details and will get back to you within one business day.
      <br />
      CedarWolf Build + Design specializes in custom homes and high-quality renovations across the Okanagan.
    </p>

    <p class="text-sm text-slate-500">
      If you need to add details, email us at
      <a href="mailto:projects@cedarwolfbuild.ca" class="underline">
        projects@cedarwolfbuild.ca
      </a>
    </p>

  </main>
</BaseLayout>
