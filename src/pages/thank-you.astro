---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Thank you | CedarWolf Build + Design"
  description="Thank you for your inquiry. We’re reviewing your request and will respond within one business day."
>
  <section class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="inline-flex items-center rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-200">
          Request received
        </p>

        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-slate-900">
          Thank you for your inquiry
        </h1>

        <p class="mt-4 text-slate-700">
          We’re reviewing your details now. You’ll hear back within <span class="font-semibold text-slate-900">1 business day</span>.
        </p>

        <div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200 shadow-sm">
          <p class="text-sm font-semibold text-slate-900">What we’re doing right now</p>
          <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Reviewing scope, photos, and timeline</li>
            <li>• Building a clear next-step plan (and rough budget range if enough info)</li>
            <li>• Confirming a short call or site visit if needed</li>
          </ul>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800"
            href={`${base}contact/`}
          >
            Send more details
          </a>

          <a
            class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-sm hover:bg-slate-50"
            href={base}
          >
            Back to home
          </a>
        </div>

        <p class="mt-6 text-sm text-slate-600">
          Need something urgent. Call
          <a class="font-semibold text-slate-900 hover:underline" href="tel:+17785941722">+1 778 594 1722</a>
          . Or email
          <a class="font-semibold text-slate-900 hover:underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a>.
        </p>
      </div>

      <div class="space-y-6">
        <figure class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 shadow-sm">
          <img
            src="/images/thank-you.jpg"
            alt="Project review in progress. CedarWolf Build + Design."
            class="h-72 w-full object-cover sm:h-80 lg:h-[420px]"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="px-5 py-4 text-sm text-slate-600">
            Probably on a jobsite or reviewing your scope.
          </figcaption>
        </figure>

        <figure class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 shadow-sm">
          <img
            src="/images/service-designpm.png"
            alt="Planning and estimating work. CedarWolf Build + Design."
            class="h-56 w-full object-cover sm:h-64"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="px-5 py-4 text-sm text-slate-600">
            Estimating. Sequencing. Preparing next steps.
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-10 rounded-2xl bg-slate-900 px-6 py-5 text-white shadow-sm">
      <p class="text-sm">
        If you don’t hear back within 1 business day, call or email us. Sometimes email filters are aggressive.
      </p>
    </div>
  </section>

  <script is:inline>
    // Google Ads conversion fires on thank-you page load
    window.addEventListener("load", () => {
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", { send_to: "AW-17823183942/sOGCCI7Gt9UbEMbo4LJC" });
      }
    });
  </script>
</BaseLayout>
