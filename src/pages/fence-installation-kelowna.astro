---
import { asset } from "../lib/asset";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceSchema from "../components/seo/ServiceSchema.astro";

const fenceTypes = [
  {
    title: "Cedar Privacy Fences",
    image: asset("images/portfolio/fence/kelowna-cedar-privacy-fence-install-cedarwolf.jpeg"),
    desc: "A classic choice for Kelowna homes. Natural cedar privacy fencing with a warm appearance and solid backyard separation.",
  },
  {
    title: "Modern Metal & Cedar",
    image: asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg"),
    desc: "Corrugated metal panels framed with cedar for a strong, modern fence with low maintenance.",
  },
  {
    title: "Horizontal Board Fences",
    image: asset("images/portfolio/fence/kelowna-horizontal-board-fence-install-cedarwolf.jpeg"),
    desc: "Clean horizontal lines for a modern residential look. Built with proper posts, alignment, and finish details.",
  },
  {
    title: "Composite Fencing",
    image: asset("images/cedarwolf-composite-fence-kelowna-01.jpg"),
    desc: "Low-maintenance fencing for homeowners looking for a modern finish with long-term durability.",
  },
  {
    title: "Custom Gates",
    image: asset("images/portfolio/fence/kelowna-custom-fence-gate-black-cedar-cedarwolf.jpeg"),
    desc: "Single gates, double gates, driveway gates, and gate repairs built to match the fence and site conditions.",
  },
  {
    title: "Fence Repairs",
    image: asset("images/handyman-fence-repairs-installation-kelowna.jpg"),
    desc: "Leaning posts, broken panels, damaged gates, storm damage, and partial replacements.",
  },
];

const faq = [
  ["Do you install both new fences and fence repairs?", "Yes. CedarWolf handles new fence installations, fence replacements, fence repairs, post replacement, gate repairs, and custom gates."],
  ["What areas do you serve?", "We serve Kelowna, West Kelowna, Lake Country, Peachland, Vernon, and nearby Okanagan communities."],
  ["Do you remove old fences?", "Yes, old fence removal and disposal can be included in the estimate when requested."],
  ["Do you build custom gates?", "Yes. We build single gates, double gates, wood gates, metal-framed gates, driveway gates, and sliding gate options depending on the project."],
  ["What fence materials do you install?", "Common options include cedar, pressure-treated wood, composite, corrugated metal, metal panels, and chain link depending on the site and budget."],
  ["Can neighbours split the cost?", "Yes. We can provide clear pricing that helps neighbours understand each side or section of the project."],
];
---

<BaseLayout
  title="Fence Installation & Repair Kelowna | CedarWolf Build + Design"
  description="Fence installation and fence repair in Kelowna and the Okanagan. Cedar fences, privacy fences, composite fencing, corrugated metal fences, custom gates, and fence replacements."
>
  <ServiceSchema
    name="Fence Installation & Repair Kelowna"
    serviceType="Fence installation and fence repair"
    description="Fence installation and fence repair services in Kelowna and the Okanagan, including cedar fences, privacy fences, composite fencing, corrugated metal fences, custom gates, and fence replacements."
    url="/fence-installation-kelowna/"
    image="/images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg"
  />

  <main class="bg-slate-50">
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img
          src={asset("images/portfolio/fence/kelowna-modern-black-metal-cedar-fence-cedarwolf.jpeg")}
          alt="Fence installation and repair in Kelowna by CedarWolf Build + Design"
          class="h-[72vh] min-h-[600px] w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/65"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="max-w-3xl">
          <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 ring-1 ring-white/15">
            Kelowna & Okanagan • Residential & Commercial Fencing
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            Fence Installation & Repair in Kelowna
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
            Cedar, wood, composite, corrugated metal, privacy fences, fence repairs, and custom gates across Kelowna and the Okanagan.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
              Request Free Estimate
            </a>
            <a href="#fence-projects" class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View Fence Projects
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {["Registered BC Business", "Fully Insured", "WorkSafeBC Covered", "Free On-Site Estimates", "Residential & Commercial"].map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold text-white shadow-sm">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Fence Contractor Kelowna</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Built for privacy, property lines, gates, and Okanagan weather.
          </h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            CedarWolf Build + Design installs and repairs fences for homes, businesses, rental properties, strata properties, and acreage-style properties across the Okanagan.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            We help with full fence replacements, new fence builds, failing posts, damaged panels, custom gates, and modern fence upgrades.
          </p>
        </div>

        <div class="grid gap-4 rounded-3xl bg-white p-6 ring-1 ring-slate-200 shadow-sm sm:grid-cols-2">
          {[
            "Privacy fence installation",
            "Fence repair and replacement",
            "Cedar and wood fencing",
            "Composite fencing",
            "Corrugated metal fencing",
            "Custom gates and driveway gates",
            "Post replacement",
            "Old fence removal available"
          ].map((item) => (
            <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-800 ring-1 ring-slate-200">
              ✓ {item}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-12">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Fence Options</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Fence Types We Install & Repair</h2>
        <p class="mt-3 max-w-3xl text-slate-600">
          Choose from traditional cedar privacy fencing, modern composite and metal options, custom gates, and targeted repairs.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {fenceTypes.map((item) => (
          <article class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={item.image} alt={item.title} class="h-60 w-full object-cover" loading="lazy" />
            <div class="p-6">
              <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Repair or Replace?</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Not every fence needs to be fully replaced.</h2>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-6 ring-1 ring-slate-200">
            <h3 class="text-xl font-semibold text-slate-900">Fence repair may be suitable when:</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-700">
              <li>✓ Only one or two posts have failed</li>
              <li>✓ The gate needs adjustment or replacement</li>
              <li>✓ A few panels or boards are damaged</li>
              <li>✓ The rest of the fence is still straight and solid</li>
            </ul>
          </div>

          <div class="rounded-2xl bg-slate-950 p-6 text-white">
            <h3 class="text-xl font-semibold">Replacement may be better when:</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-300">
              <li>✓ Multiple posts are leaning or rotted</li>
              <li>✓ Large sections are failing</li>
              <li>✓ The fence has already been repaired several times</li>
              <li>✓ You want a new style, privacy level, or gate layout</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="fence-projects" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Recent Work</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Fence Projects & Gate Options</h2>
          <p class="mt-3 max-w-3xl text-slate-600">
            Examples of fence styles, gate options, and completed work across Kelowna and nearby communities.
          </p>
        </div>
        <a href={asset("contact/")} class="inline-flex rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
          Request Estimate
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          asset("images/portfolio/fence/kelowna-cedar-lattice-top-privacy-fence-cedarwolf.jpeg"),
          asset("images/portfolio/fence/kelowna-fence-construction-cedar-posts-cedarwolf.jpeg"),
          asset("images/cedarwolf-corrugated-fence-kelowna-01.jpg"),
          asset("images/cedarwolf-sliding-gate-kelowna-01.jpg"),
          asset("images/cedarwolf-metal-gate-kelowna-01.jpg"),
          asset("images/cedarwolf-composite-fence-kelowna-02.jpg"),
          asset("images/portfolio/fence/kelowna-wood-privacy-fence-backyard-cedarwolf.jpeg"),
          asset("images/portfolio/fence/kelowna-fence-styles-wood-metal-cedar-cedarwolf.jpeg"),
        ].map((src) => (
          <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img src={src} alt="Fence and gate project by CedarWolf Build + Design in Kelowna" class="h-56 w-full object-cover transition duration-300 hover:scale-105" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">Common Reasons</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Why property owners call us for fencing.</h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {["Leaning fence", "Rotten posts", "Broken gate", "Storm damage", "Privacy upgrade", "Pet containment", "Property line separation", "Modern curb appeal"].map((item) => (
              <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-800 ring-1 ring-slate-200">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-3xl bg-slate-950 p-8 text-white">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">Material Options</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight">Popular fence materials.</h2>
          <div class="mt-6 space-y-4 text-sm">
            {[
              ["Cedar", "Natural look, strong privacy, classic Okanagan style."],
              ["Pressure-Treated Wood", "Durable structural option for posts and framing."],
              ["Composite", "Low-maintenance modern fence option."],
              ["Corrugated Metal", "Strong, private, contemporary, and low-maintenance."],
              ["Chain Link", "Functional option for security, pets, and larger areas."]
            ].map(([name, desc]) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                <p class="font-semibold text-white">{name}</p>
                <p class="mt-1 text-slate-300">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">FAQ</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Fence questions homeowners often ask.</h2>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {faq.map(([q, a]) => (
            <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
              <h3 class="font-semibold text-slate-900">{q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="rounded-3xl bg-emerald-700 p-8 text-white shadow-sm md:p-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">Need a fence installed or repaired?</h2>
            <p class="mt-3 max-w-2xl text-emerald-50">
              Send your location, approximate length, photos if available, and whether you need a repair, replacement, or new installation.
            </p>
          </div>
          <a href={asset("contact/")} class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
            Request Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
