---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    label: "Residential Renovations",
    title: "Kitchen Renovations",
    description: "Cabinet installs, lighting, finish carpentry, and layout upgrades. Built for daily use, not just photos.",
    bullets: ["Clear scope and sequencing", "Cabinetry and millwork install", "Clean, durable finishes"],
    image: "/images/service-kitchen.png",
    accent: "emerald",
  },
  {
    label: "Millwork",
    title: "Cabinets and Built-ins",
    description: "Custom-looking results with clean lines and tight reveals. Storage that actually works in real homes.",
    bullets: ["Built-ins and feature walls", "Cabinet upgrades and installs", "Trim and finishing details"],
    image: "/images/service-cabinets.png",
    accent: "slate",
  },
  {
    label: "Interiors",
    title: "Flooring",
    description: "Solid prep, clean transitions, and a finished look that makes the whole home feel upgraded.",
    bullets: ["Subfloor prep and leveling", "Install and transitions", "Baseboards and trim as needed"],
    image: "/images/service-flooring.png",
    accent: "amber",
  },
  {
    label: "Finishes",
    title: "Painting",
    description: "Sharp lines, smooth walls, and a clean jobsite. The fastest way to make a home feel new again.",
    bullets: ["Patch, prep, sand properly", "Interior walls and trim", "Clean edges and even coverage"],
    image: "/images/service-painting.png",
    accent: "sky",
  },
];
---

<BaseLayout title="CedarWolf Build + Design | Kelowna Renovations">
  <Nav />

  <main class="bg-slate-50">
    <!-- HERO -->
    <section class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <img src="/images/lake-sunset.png" alt="Kelowna lake sunset" class="h-[70vh] w-full object-cover" />
        <div class="absolute inset-0 bg-slate-950/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-slate-950/25 to-transparent"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 pt-24 pb-16">
        <div class="max-w-2xl">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white ring-1 ring-white/15">
            Kelowna + Okanagan • Residential Renovations
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            High-end renovations, built to last.
          </h1>

          <p class="mt-5 text-base leading-relaxed text-white/80 sm:text-lg">
            Kitchens, built-ins, flooring, and finish work. Clear scope, clean execution, and a jobsite you can live with.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact"
              class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-700/30">
              Get a quote
            </a>
            <a href="/portfolio"
              class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15">
              View projects
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="mx-auto max-w-7xl px-6 py-10">
      <div class="grid gap-4 rounded-2xl bg-white p-6 ring-1 ring-slate-200/70 shadow-sm sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold text-slate-900">Clear scope</p>
          <p class="mt-1 text-sm text-slate-600">No vague promises. You know what’s included.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Clean finishes</p>
          <p class="mt-1 text-sm text-slate-600">Tight details. Durable materials. Proper prep.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Respectful jobsite</p>
          <p class="mt-1 text-sm text-slate-600">Dust control, protection, and communication.</p>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="mx-auto max-w-7xl px-6 pb-16">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900">What we do</h2>
          <p class="mt-2 text-slate-600">Focused services, done properly. No chaos, no shortcuts.</p>
        </div>
        <a href="/services" class="hidden rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 sm:inline-flex">
          All services
        </a>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {services.map((s) => (
          <ServiceCard {...s} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
