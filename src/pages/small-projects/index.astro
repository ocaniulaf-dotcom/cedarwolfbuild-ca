---
import BaseLayout from "../../layouts/BaseLayout.astro";

const PHONE_DISPLAY = "778-594-1722";
const PHONE_TEL = "+17785941722";
const EMAIL = "projects@cedarwolfbuild.ca";

const IMAGES = [
  {
    src: "/images/handyman-deck-railing-stair-repairs-kelowna.jpg",
    title: "Deck railings + stairs",
    alt: "Deck railing and stair repairs in Kelowna",
    caption: "Deck railing and stair repairs completed to improve safety and stability. Railings were secured and stairs rebuilt for solid, consistent footing.",
  },
  {
    src: "/images/handyman-deck-safety-code-repairs-kelowna.jpg",
    title: "Deck safety upgrades",
    alt: "Deck safety upgrades in Kelowna",
    caption: "Deck safety upgrades focused on structural integrity and durable connections. Movement corrected and key points reinforced to reduce long-term issues.",
  },
  {
    src: "/images/handyman-deck-stair-repairs-kelowna.jpg",
    title: "Deck stair repairs",
    alt: "Deck stair repairs in Kelowna",
    caption: "Stair repairs addressing uneven treads and worn framing. Steps rebuilt for consistent height, solid fastening, and daily use without wobble.",
  },
  {
    src: "/images/handyman-fence-repairs-installation-kelowna.jpg",
    title: "Fence repairs",
    alt: "Fence repairs in Kelowna",
    caption: "Fence repairs and partial replacement to correct leaning sections and loose posts. Panels realigned and secured for a straight, durable finish.",
  },
  {
    src: "/images/handyman-interior-door-trim-repairs-kelowna.jpg",
    title: "Interior doors + trim",
    alt: "Interior door and trim repairs in Kelowna",
    caption: "Interior door and trim repairs to fix alignment, gaps, and finish issues. Doors adjusted to swing properly and trim reinstalled with clean joints.",
  },
  {
    src: "/images/handyman-pergola-outdoor-structures-kelowna.jpg",
    title: "Pergolas + outdoor builds",
    alt: "Pergola and outdoor structures in Kelowna",
    caption: "Outdoor structure built for long-term exposure. Posts anchored properly, layout kept square, and details finished clean for a solid final look.",
  },
];
---

<BaseLayout
  title="Small Projects and Repairs in Kelowna | CedarWolf Build + Design"
  description="Small projects and repairs in Kelowna and the Okanagan. Deck repairs, stairs, railings, fences, doors, trim, and outdoor structures. Email-first quotes."
>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <!-- HERO -->
    <section class="grid gap-8 md:grid-cols-2 md:items-center">
      <div class="space-y-5">
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700">
          Small projects . Repairs . Punch-lists
        </p>

        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 md:text-5xl">
          Small Projects in Kelowna and the Okanagan
        </h1>

        <p class="text-base leading-relaxed text-slate-700 md:text-lg">
          Repairs and small upgrades handled professionally. Email is the fastest way to reach us while we’re on job sites.
          We respond within 1 business day.
        </p>

        <ul class="grid gap-2 text-sm text-slate-700">
          <li>Deck repairs . stairs . railings . safety fixes</li>
          <li>Fence repairs and installation</li>
          <li>Interior door and trim repairs</li>
          <li>Pergolas and outdoor structures</li>
        </ul>

        <p class="text-sm text-slate-700"><strong>Email:</strong> <a class="underline hover:no-underline" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a><br><span class="text-xs text-slate-500">Quotes are reviewed off-site. Responses are typically sent within 1 business day.</span></p>

        <p class="text-xs text-slate-500">
          Email: <a class="underline hover:no-underline" href={"mailto:" + EMAIL}>{EMAIL}</a> . Phone is answered when available.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-base font-semibold text-slate-900">Fast quote checklist</h2>
        <ol class="mt-3 grid gap-2 text-sm text-slate-700">
          <li><span class="font-semibold">1.</span> 2–4 photos</li>
          <li><span class="font-semibold">2.</span> Your city (Kelowna, West Kelowna, etc.)</li>
          <li><span class="font-semibold">3.</span> What you want done + timeline</li>
        </ol>
        <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-900">Heads-up</p>
          <p class="mt-1 text-sm text-slate-700">
            Small projects are scheduled around larger renovations. If it’s urgent, call and we’ll tell you straight.
          </p>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="mt-14">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-900">Examples of small projects</h2>
          <p class="mt-1 text-sm text-slate-600">Tap any photo to view it larger.</p>
        </div>

        <a
          href="/contact/?service=small-projects"
          class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800"
        >
          Get a quote
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {IMAGES.map((img, idx) => (
          <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <button
              type="button"
              class="block w-full"
              data-src={img.src}
              data-title={img.title}
              data-caption={img.caption}
              data-alt={img.alt}
              aria-label={"View " + img.title + " photo"}
            >
              <div class="aspect-[4/3] bg-slate-50 p-2">
                <img
                  src={img.src}
                  alt={img.alt}
                  class="h-full w-full object-contain"
                  loading="lazy"
                />
              </div>
            </button>

            <figcaption class="p-4">
              <p class="text-sm font-semibold text-slate-900">{img.title}</p>
              <p class="mt-1 text-sm text-slate-700">{img.caption}</p>
              <p class="mt-2 text-xs text-slate-600">Kelowna + Okanagan</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- LIGHTBOX -->
    <dialog id="lightbox" class="backdrop:bg-black/70 rounded-2xl p-0 max-w-5xl w-[min(92vw,1100px)]">
      <div class="relative overflow-hidden rounded-2xl bg-white">
        <button
          id="lightboxClose"
          type="button"
          class="absolute right-3 top-3 z-10 rounded-xl bg-white/90 px-3 py-2 text-sm font-semibold text-slate-900 shadow hover:bg-white"
        >
          Close
        </button>

        <img id="lightboxImg" src="" alt="" class="block h-auto w-full max-h-[82vh] object-contain bg-slate-950" />

        <div class="border-t border-slate-200 bg-white px-5 py-4">
          <p id="lightboxTitle" class="text-sm font-semibold text-slate-900"></p>
          <p id="lightboxCaption" class="mt-1 text-sm text-slate-700"></p>
        </div>
      </div>
    </dialog>

    <script>
      const dlg = document.getElementById("lightbox");
      const imgEl = document.getElementById("lightboxImg");
      const titleEl = document.getElementById("lightboxTitle");
      const capEl = document.getElementById("lightboxCaption");
      const closeBtn = document.getElementById("lightboxClose");

      function openLightbox(src, alt, title, caption) {
        imgEl.src = src;
        imgEl.alt = alt || "";
        titleEl.textContent = title || "";
        capEl.textContent = caption || "";
        if (typeof dlg.showModal === "function") dlg.showModal();
        else dlg.setAttribute("open", "");
      }

      document.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-src]");
        if (!btn) return;
        openLightbox(
          btn.getAttribute("data-src"),
          btn.getAttribute("data-alt"),
          btn.getAttribute("data-title"),
          btn.getAttribute("data-caption")
        );
      });

      closeBtn.addEventListener("click", () => dlg.close());

      dlg.addEventListener("click", (e) => {
        const box = dlg.querySelector("div");
        if (!box) return;
        const r = box.getBoundingClientRect();
        const inside =
          e.clientX >= r.left && e.clientX <= r.right &&
          e.clientY >= r.top && e.clientY <= r.bottom;
        if (!inside) dlg.close();
      });
    </script>
  </main>
</BaseLayout>
