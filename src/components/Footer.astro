---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="relative overflow-hidden border-t border-stone-300 bg-gradient-to-b from-stone-100 to-stone-200 text-slate-800">
  <!-- subtle grain -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.12]
    [background-image:
      radial-gradient(rgba(0,0,0,0.08)_1px,transparent_1px),
      radial-gradient(rgba(0,0,0,0.05)_1px,transparent_1px)
    ]
    [background-size:24px_24px,18px_18px]
    [background-position:0_0,9px_9px]
  "></div>

  <!-- soft top fade -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-white/0 via-white/0 to-white/35"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-semibold tracking-tight text-slate-900">CedarWolf Build + Design</p>
        <div class="mt-3">
          <SocialLinks />
        </div>
        <p class="mt-4 max-w-sm text-sm leading-6 text-slate-700">
          Renovations and small builds in Kelowna and the Okanagan. Clear scope. Clean execution. Professional finish.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">Contact</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-700">
          <li><span class="text-slate-600">Phone:</span> +1 778 594 1722</li>
          <li>
            <span class="text-slate-600">Email:</span>
            <a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href="mailto:projects@cedarwolfbuild.ca">
              projects@cedarwolfbuild.ca
            </a>
          </li>
          <li><span class="text-slate-600">Service area:</span> Kelowna, West Kelowna, Lake Country, Peachland, Vernon</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">Pages</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-700">
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={link("services/")}>Services</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={link("portfolio/")}>Portfolio</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={link("about/")}>About</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href="privacy">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-stone-300/70 pt-6 text-xs text-slate-600">
      © 2025 CedarWolf Build + Design. All rights reserved.
    </div>
  </div>
</footer>
