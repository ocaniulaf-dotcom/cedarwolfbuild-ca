---
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
const phone = "+1 778 594 1722";
const email = "projects@cedarwolfbuild.ca";

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : baseRaw + "/";
const withBase = (p) => new URL(p, Astro.url.origin + base).pathname;
---




<!-- INSTAGRAM BANNER -->
<div style="background-color: #2d3748;" class="border-t border-slate-600">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-center md:justify-between">
      <div class="text-center md:text-left">
        <div class="flex items-center justify-center gap-3 md:justify-start">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9 text-pink-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          <p class="text-2xl font-semibold text-white">Follow Our Work on Instagram</p>
        </div>
        <p class="mt-3 max-w-md text-base text-slate-300">Decks, fences, and renovations in Kelowna — see our latest projects as they happen.</p>
        <a href="https://www.instagram.com/cedarwolf.build.design" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-2xl px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:opacity-90" style="background: linear-gradient(to right, #f472b6, #ef4444, #f59e0b);">
          Follow @cedarwolf.build.design
        </a>
      </div>
      <div class="flex flex-shrink-0 flex-col items-center gap-3">
        <img src="/images/social/cedarwolf.build.design_qr.png" alt="Scan to follow CedarWolf on Instagram" class="h-52 w-52 rounded-2xl bg-white p-1 shadow-lg" />
        <p class="text-sm text-slate-300">Scan to follow us on Instagram</p>
      </div>
    </div>
  </div>
</div>
<!-- END INSTAGRAM BANNER -->

<footer class="border-t">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <table class="w-full table-fixed border-collapse">
      <tbody>
        <tr class="align-top">
          <td class="w-1/3 px-2">
            <div class="font-semibold">CedarWolf Build + Design</div>

            <p class="mt-2 text-sm text-slate-600">
              Renovations and small builds in Kelowna and the Okanagan. Clear scope. Realistic schedule. Clean finish.
            </p>

            <div class="mt-4">
              <SocialLinks />
            </div>
          </td>

          <td class="w-1/3 px-2">
            <div class="font-semibold">Contact</div>
            <ul class="mt-2 space-y-2 text-sm">
              <li><span class="text-slate-500">Phone:</span> {phone}</li>
              <li>
                <span class="text-slate-500">Email:</span>{" "}
                <a class="underline" href={`mailto:${email}`}>{email}</a>
              </li>
              <li>
                <span class="text-slate-500">Service area:</span>{" "}
                Kelowna. West Kelowna. Lake Country. Peachland. Vernon
              </li>
            </ul>
          </td>

          <td class="w-1/3 px-2">
            <div class="font-semibold">Pages</div>
            <ul class="mt-2 space-y-2 text-sm">              <li><a class="underline" href={withBase("/")}>Home</a></li>

              <li><a class="underline" href={withBase("/services/")}>Services</a></li>
              <li><a class="underline" href={withBase("/deck-building-kelowna/")}>Deck Building</a></li>
              <li><a class="underline" href={withBase("/fence-installation-kelowna/")}>Fence Installation</a></li>
              <li><a class="underline" href={withBase("/epoxy-floor-coating-kelowna/")}>Epoxy Floor Coating</a></li>
                            <li><a class="underline" href={withBase("/small-projects/")}>Small Projects</a></li>
<li><a class="underline" href={withBase("/portfolio/")}>Portfolio</a></li>
      <li><a class="underline" href={withBase("/portfolio/kitchen-renovations/")}>Kitchen Renovations</a></li>
              <li><a class="underline" href={withBase("/about/")}>About</a></li>
              <li><a class="underline" href={withBase("/privacy/")}>Privacy</a></li>
            </ul>
          </td>
        </tr>

        <tr>
          <td colspan="3" class="px-2 pt-6">
            <!-- TRUST_BADGES_START -->
            <div class="w-full rounded-xl border border-slate-200 bg-white p-4 text-center shadow-sm">
              <p class="text-sm font-semibold text-slate-900">
                CedarWolf Build + Design is licensed, insured, and WorkSafeBC registered.
              </p>
            </div>
            <!-- TRUST_BADGES_END -->
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-10 text-xs text-slate-500">
    © {year} CedarWolf Build + Design. All rights reserved.
  </div>
</footer>
