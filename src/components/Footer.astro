---
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
const phone = "+1 778 594 1722";
const phoneHref = "tel:+17785941722";
const email = "projects@cedarwolfbuild.ca";

const baseRaw = import.meta.env.BASE_URL || "/";
const base = baseRaw.endsWith("/") ? baseRaw : baseRaw + "/";
const withBase = (p) => new URL(p, Astro.url.origin + base).pathname;

const services = [
  ["Fence Installation & Repair", "/fence-installation-kelowna/"],
  ["Deck Building & Repair", "/deck-building-kelowna/"],
  ["Land Clearing", "/forestry-mulching-skid-steer-services-kelowna/"],
  ["Epoxy Floor Coating", "/epoxy-floor-coating-kelowna/"],
  ["Kitchen Renovations", "/portfolio/kitchen-renovations/"],
  ["Small Projects", "/small-projects/"],
];

const company = [
  ["Services", "/services/"],
  ["Portfolio", "/portfolio/"],
  ["About", "/about/"],
  ["Contact", "/contact/"],
  ["Privacy", "/privacy/"],
];

const areas = ["Kelowna", "West Kelowna", "Lake Country", "Peachland", "Vernon", "Okanagan Area"];

const trust = [
  "Registered BC Business",
  "Fully Insured",
  "WorkSafeBC Covered",
  "Free On-Site Estimates",
  "Residential & Commercial",
];
---

<!-- INSTAGRAM BANNER -->
<section class="border-t border-slate-800 bg-slate-900 text-white">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-pink-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          <p class="text-2xl font-semibold">Follow Our Work on Instagram</p>
        </div>
        <p class="mt-3 max-w-2xl text-slate-300">
          Fences, decks, renovations, land clearing, and property improvement work across Kelowna and the Okanagan.
        </p>
        <a
          href="https://www.instagram.com/cedarwolf.build.design"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
        >
          Follow @cedarwolf.build.design
        </a>
      </div>

      <div class="flex flex-col items-center gap-3">
        <img src="/images/social/cedarwolf.build.design_qr.png" alt="Scan to follow CedarWolf Build + Design on Instagram" width="2350" height="2700" loading="lazy" decoding="async" class="h-44 w-44 rounded-2xl bg-white p-1 shadow-lg" />
        <p class="text-sm text-slate-300">Scan to follow us</p>
      </div>
    </div>
  </div>
</section>
<!-- END INSTAGRAM BANNER -->

<footer class="bg-slate-950 text-white">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.9fr_0.9fr_0.9fr]">
      <div>
        <p class="text-xl font-semibold">CedarWolf Build + Design</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
          Construction and renovation services for homeowners, businesses, and property owners across Kelowna and the Okanagan.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={withBase("/contact/")} class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600">
            Request Free Estimate
          </a>
          <a href={phoneHref} class="inline-flex items-center justify-center rounded-2xl border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Call {phone}
          </a>
        </div>

        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Services</p>
        <ul class="mt-4 space-y-3 text-sm">
          {services.map(([label, href]) => (
            <li>
              <a class="text-slate-300 transition hover:text-white hover:underline" href={withBase(href)}>{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Company</p>
        <ul class="mt-4 space-y-3 text-sm">
          {company.map(([label, href]) => (
            <li>
              <a class="text-slate-300 transition hover:text-white hover:underline" href={withBase(href)}>{label}</a>
            </li>
          ))}
        </ul>

        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Contact</p>
        <ul class="mt-4 space-y-3 text-sm text-slate-300">
          <li><a class="hover:text-white hover:underline" href={phoneHref}>{phone}</a></li>
          <li><a class="hover:text-white hover:underline" href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Service Area</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {areas.map((area) => (
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-200 ring-1 ring-white/10">{area}</span>
          ))}
        </div>

        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Build With Confidence</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          {trust.map((item) => (
            <li>✓ {item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-sm text-slate-400">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p>© {year} CedarWolf Build + Design. All rights reserved.</p>
        <p>Construction & renovation services in Kelowna and the Okanagan.</p>
      </div>
    </div>
  </div>
</footer>
