---
import { asset } from "../lib/asset";
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-stone-300 bg-gradient-to-b from-stone-100 to-stone-200 text-slate-800">
  <!-- subtle grain -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.12] [background-image:radial-gradient(#000_1px,transparent_1px)] [background-size:18px_18px]"></div>

  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="text-lg font-semibold tracking-tight">CedarWolf Build + Design</div>
        <p class="mt-3 max-w-sm text-sm text-slate-600">
          Kelowna + Okanagan residential renovations. Clear scope, clean finishes, and a jobsite you can live with.
        </p>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900">Pages</div>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("")}>Home</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("services/")}>Services</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("portfolio/")}>Portfolio</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("about/")}>About</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("contact/")}>Contact</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={asset("privacy/")}>Privacy</a></li>
        </ul>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900">Get a quote</div>
        <p class="mt-4 text-sm text-slate-600">
          Send a short scope, rough dimensions, and a few photos. We will respond with next steps.
        </p>
        <div class="mt-5">
          <a
            class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
            href={asset("contact/")}
          >
            Contact
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-stone-300/70 pt-6 text-xs text-slate-600">
      © {year} CedarWolf Build + Design. All rights reserved.
    </div>
  </div>
</footer>

