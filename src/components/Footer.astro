---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="border-t border-slate-200">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div>
        <p class="text-2xl font-semibold tracking-tight text-slate-900">
          CedarWolf Build + Design
        </p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-slate-600">
          Kelowna + Okanagan residential renovations. Clear scope, clean finishes, and a jobsite you can live with.
        </p>

        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">Pages</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/">Home</a></li>
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/services">Services</a></li>
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/portfolio">Portfolio</a></li>
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/about">About</a></li>
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/contact">Contact</a></li>
          <li><a class="text-slate-700 underline-offset-4 hover:underline" href="/privacy">Privacy</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">Get a quote</p>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-slate-600">
          Send a short scope, rough dimensions, and a few photos. We will respond with next steps.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center rounded-full bg-slate-900 px-7 py-3 text-sm font-semibold text-white hover:bg-slate-800"
        >
          Contact
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6">
      <p class="text-xs text-slate-500">
        © {new Date().getFullYear()} CedarWolf Build + Design. All rights reserved.
      </p>
    </div>
  </div>
</footer>
