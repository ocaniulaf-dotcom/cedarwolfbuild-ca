---
const BASE = import.meta.env.BASE_URL;
const page = (p) => `${BASE}${String(p).replace(/^\/+/, "")}`;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-stone-300 bg-gradient-to-b from-stone-100 to-stone-200 text-slate-800">
  <!-- subtle grain -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.12] [background-image:radial-gradient(#000_1px,transparent_1px)] [background-size:18px_18px]"></div>

  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="text-lg font-semibold tracking-tight">CedarWolf Build + Design</div>
        <p class="mt-3 max-w-sm text-sm text-slate-600">
          Kelowna + Okanagan residential renovations. Clear scope, clean finishes, and a jobsite you can live with.
        </p>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900">Pages</div>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={BASE}>Home</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={page("services/")}>Services</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={page("portfolio/")}>Portfolio</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={page("about/")}>About</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={page("contact/")}>Contact</a></li>
          <li><a class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900" href={page("privacy/")}>Privacy</a></li>
        </ul>
      </div>

      <div>
        <div class="text-sm font-semibold text-slate-900">Get a quote</div>
        <p class="mt-4 text-sm text-slate-600">
          Send a short scope, rough dimensions, and a few photos. We will respond with next steps.
        </p>
        <div class="mt-5">
          <a
            class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
            href={page("contact/")}
          >
            Contact
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-stone-300/70 pt-6 text-xs text-slate-600">
      © {year} CedarWolf Build + Design. All rights reserved.
    </div>
  </div>

      <div class="mt-6 flex gap-3">
        <a href="https://www.instagram.com/cedarwolf.build.design/" target="_blank" rel="noopener noreferrer"
           class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/70 ring-1 ring-slate-200 hover:bg-white"
           aria-label="Instagram" title="Instagram">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-slate-700"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm6.1-.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Z"/></svg>
        </a>

        <a href="https://www.linkedin.com/company/cedarwolf-build-design/" target="_blank" rel="noopener noreferrer"
           class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/70 ring-1 ring-slate-200 hover:bg-white"
           aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-slate-700"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 8.98h4v12H3ZM9 8.98h3.8v1.64h.05a4.2 4.2 0 0 1 3.78-2.08c4.05 0 4.8 2.67 4.8 6.14V21h-4v-5.46c0-1.3-.03-2.98-1.82-2.98-1.82 0-2.1 1.42-2.1 2.88V21H9Z"/></svg>
        </a>

        <a href="https://www.facebook.com/profile.php?id=61583675863632" target="_blank" rel="noopener noreferrer"
           class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/70 ring-1 ring-slate-200 hover:bg-white"
           aria-label="Facebook" title="Facebook">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-slate-700"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
      </div>

</footer>

