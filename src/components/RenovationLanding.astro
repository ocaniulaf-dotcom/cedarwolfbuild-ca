---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceSchema from "./seo/ServiceSchema.astro";
import FAQSchema from "./seo/FAQSchema.astro";
import BreadcrumbSchema from "./seo/BreadcrumbSchema.astro";

const {
  title,
  description,
  h1,
  eyebrow,
  intro,
  serviceName,
  serviceType,
  serviceOutput,
  url,
  hero,
  heroAlt,
  services = [],
  projects = [],
  faq = [],
  related = [],
} = Astro.props;

const trust = [
  "Registered BC Business",
  "Fully Insured",
  "WorkSafeBC Covered",
  "Free On-Site Estimates",
  "Residential & Commercial",
];
---

<BaseLayout
  title={title}
  description={description}
  image={hero}
  preloadImage={hero}
>
  <ServiceSchema
    name={serviceName}
    serviceType={serviceType}
    serviceOutput={serviceOutput}
    description={description}
    url={url}
    image={hero}
  />

  <FAQSchema items={faq} />

  <BreadcrumbSchema
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services/" },
      { name: serviceName, url }
    ]}
  />

  <main class="bg-slate-50">

    <!-- HERO -->
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img
          src={hero}
          alt={heroAlt}
          width="1600"
          height="1000"
          fetchpriority="high"
          decoding="async"
          class="h-[72vh] min-h-[600px] w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/45"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/55 to-slate-950/10"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
        <div class="max-w-3xl">
          <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 ring-1 ring-white/15">
            {eyebrow}
          </p>

          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl">
            {h1}
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90 sm:text-xl">
            {intro}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center rounded-2xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600"
            >
              Request Free Estimate
            </a>

            <a
              href="#projects"
              class="inline-flex items-center justify-center rounded-2xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/15"
            >
              View Our Work
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {trust.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold text-white shadow-sm">
                ✓ {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">
            Renovation Contractor Kelowna
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Renovation projects managed from planning through finishing.
          </h2>

          <p class="mt-5 leading-relaxed text-slate-600">
            CedarWolf Build + Design works with homeowners and property owners on complete renovation projects across Kelowna and the Okanagan. We can manage demolition, preparation, construction, installation and finishing while coordinating specialized trades when required.
          </p>

          <p class="mt-4 leading-relaxed text-slate-600">
            Our focus is a clear project scope, practical recommendations and quality construction that improves how your space looks and functions.
          </p>
        </div>

        <div class="grid gap-4 rounded-3xl bg-white p-6 ring-1 ring-slate-200 shadow-sm sm:grid-cols-2">
          {[
            "Project planning & scope",
            "Demolition & preparation",
            "Framing & drywall",
            "Cabinet installation",
            "Flooring & finishing",
            "Doors, trim & millwork",
            "Painting & final details",
            "Trade coordination",
          ].map((item) => (
            <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-800 ring-1 ring-slate-200">
              ✓ {item}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="mx-auto max-w-7xl px-6 py-12">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">
          Project Scope
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
          What we can include in your renovation.
        </h2>

        <p class="mt-3 text-slate-600">
          Every project is different. We review the existing space, your priorities and the required work before preparing the scope.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((item) => (
          <article class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img
              src={item.image}
              alt={item.alt || item.title}
              width="960"
              height="650"
              class="h-60 w-full object-cover"
              loading="lazy"
              decoding="async"
            />

            <div class="p-6">
              <h3 class="text-xl font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">
            Recent Work
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Recent Renovation Work
          </h2>

          <p class="mt-3 max-w-3xl text-slate-600">
            Real examples of renovation, installation and finishing work completed by CedarWolf Build + Design in the Okanagan.
          </p>
        </div>

        <a
          href="/contact/"
          class="inline-flex rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600"
        >
          Request Estimate
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <figure class="overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200 shadow-sm">
            <img
              src={project.image}
              alt={project.alt}
              width="960"
              height="720"
              class="h-72 w-full object-cover transition duration-300 hover:scale-105"
              loading="lazy"
              decoding="async"
            />

            <figcaption class="p-5">
              <h3 class="font-semibold text-slate-900">{project.title}</h3>
              {project.desc && (
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{project.desc}</p>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- PROCESS -->
    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-slate-950 p-8 text-white md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">
          Our Process
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight">
          From site visit to completed renovation.
        </h2>

        <div class="mt-8 grid gap-5 md:grid-cols-4">
          {[
            ["01", "Site Visit", "We review the space, existing conditions, access and your renovation goals."],
            ["02", "Scope & Estimate", "We define the work, materials and project requirements before construction begins."],
            ["03", "Construction", "Demolition, preparation, construction and installation are completed in sequence."],
            ["04", "Finishing", "Final details, cleanup and finishing work complete the renovation."],
          ].map(([number, heading, text]) => (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-5">
              <p class="text-sm font-bold text-amber-300">{number}</p>
              <h3 class="mt-3 text-lg font-semibold">{heading}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED -->
    {related.length > 0 && (
      <section class="mx-auto max-w-7xl px-6 py-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">
            Renovation Services
          </p>

          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
            Explore related renovation services.
          </h2>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {related.map((item) => (
            <a
              href={item.href}
              class="rounded-2xl bg-white p-6 ring-1 ring-slate-200 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{item.desc}</p>
              <p class="mt-4 text-sm font-semibold text-emerald-800">Learn more →</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl bg-white p-8 ring-1 ring-slate-200 shadow-sm md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-emerald-800">
          FAQ
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">
          Renovation questions.
        </h2>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {faq.map(([q, a]) => (
            <div class="rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200">
              <h3 class="font-semibold text-slate-900">{q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="rounded-3xl bg-emerald-700 p-8 text-white shadow-sm md:p-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight">
              Planning a renovation?
            </h2>

            <p class="mt-3 max-w-2xl text-emerald-50">
              Send us your project location, photos, approximate scope and what you would like to change. We can arrange an on-site visit to review the project and discuss the next steps.
            </p>
          </div>

          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50"
          >
            Request Free Estimate
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
