---
const BASE = import.meta.env.BASE_URL;   // "/cedarwolfbuild-ca/"
const page = (p) => `${BASE}${String(p).replace(/^\/+/, '')}`;

const items = [
  { href: BASE, label: "Home" },
  { href: page("services/"), label: "Services" },
  { href: page("portfolio/"), label: "Portfolio" },
  { href: page("about/"), label: "About" },
  { href: page("contact/"), label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a class="text-lg font-semibold tracking-tight text-slate-900" href={BASE}>
      CedarWolf <span class="text-brand-700">Build + Design</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {items.map((i) => (
        <a class="text-base text-slate-700 hover:text-brand-800" href={i.href}>{i.label}</a>
      ))}
    </nav>

    <a
      class="rounded-xl bg-brand-700 px-5 py-3 text-base font-medium text-white shadow-soft hover:bg-brand-800"
      href={asset("contact/")}
    >
      Get a quote
    </a>
  </div>
</header>
