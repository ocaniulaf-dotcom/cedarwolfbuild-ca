---
const links = [
  { name: "Instagram", href: "https://www.instagram.com/cedarwolf.build.design/" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/cedarwolf-build-design/" },
  { name: "Facebook", href: "https://www.facebook.com/profile.php?id=61583675863632" },
];
---

<nav aria-label="Social links" class="flex items-center gap-3">
  {links.map((l) => (
    <a
      href={l.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={l.name}
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white/80 text-slate-800 shadow-sm transition hover:bg-white hover:shadow"
    >
      <span class="text-sm font-semibold">{l.name[0]}</span>
    </a>
  ))}
</nav>
