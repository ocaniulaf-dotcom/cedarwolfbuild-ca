---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="relative overflow-hidden bg-slate-950 text-slate-200">
  <!-- subtle steel texture -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.22]
    [background-image:
      linear-gradient(135deg,rgba(255,255,255,0.08)_25%,transparent_25%,transparent_50%,rgba(255,255,255,0.08)_50%,rgba(255,255,255,0.08)_75%,transparent_75%,transparent),
      linear-gradient(45deg,rgba(255,255,255,0.05)_25%,transparent_25%,transparent_50%,rgba(255,255,255,0.05)_50%,rgba(255,255,255,0.05)_75%,transparent_75%,transparent)
    ]
    [background-size:34px_34px,34px_34px]
    [background-position:0_0,17px_17px]
  "></div>

  <!-- soft vignette -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-semibold tracking-tight text-white">CedarWolf Build + Design</p>
        <div class="mt-3">
          <SocialLinks />
        </div>
        <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">
          Renovations and small builds in Kelowna and the Okanagan. Clear scope. Clean execution. Professional finish.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold text-white">Contact</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          <li><span class="text-slate-400">Phone:</span> +1 778 594 1722</li>
          <li><span class="text-slate-400">Email:</span> <a class="underline decoration-slate-600 underline-offset-4 hover:text-white" href="mailto:projects@cedarwolfbuild.ca">projects@cedarwolfbuild.ca</a></li>
          <li><span class="text-slate-400">Service area:</span> Kelowna, West Kelowna, Lake Country, Peachland, Vernon</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-white">Pages</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          <li><a class="underline decoration-slate-600 underline-offset-4 hover:text-white" href="/services">Services</a></li>
          <li><a class="underline decoration-slate-600 underline-offset-4 hover:text-white" href="/portfolio">Portfolio</a></li>
          <li><a class="underline decoration-slate-600 underline-offset-4 hover:text-white" href="/about">About</a></li>
          <li><a class="underline decoration-slate-600 underline-offset-4 hover:text-white" href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs text-slate-400">
      © 2025 CedarWolf Build + Design. All rights reserved.
    </div>
  </div>
</footer>
